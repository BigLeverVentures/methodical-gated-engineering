{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hook.cjs\"",
            "timeout": 20,
            "additionalContextLimit": 12000
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hook.cjs\"",
            "timeout": 20
          }
        ],
        "matcher": "^(Agent|spawn_agent|collaborationspawn_agent)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hook.cjs\"",
            "timeout": 20
          }
        ],
        "matcher": "^(Agent|spawn_agent|collaborationspawn_agent)$"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hook.cjs\"",
            "timeout": 20
          }
        ],
        "matcher": "^(Agent|spawn_agent|collaborationspawn_agent)$"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hook.cjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hook.cjs\"",
            "timeout": 20
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/hook.cjs\"",
            "timeout": 20
          }
        ],
        "matcher": "manual|auto"
      }
    ]
  }
}
